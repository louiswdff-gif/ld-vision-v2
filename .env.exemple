# Copiez ce fichier en `.env` (jamais committé) et remplissez vos secrets.
# Les NOMS de ces variables sont ceux référencés dans config.yaml (clé `webhook:`).

# Webhook Discord par défaut (alertes + messages « bot en pause / reprise »)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxxxxxxxxxxxxxx

# Un webhook (salon) différent pour une veille : déclarez-le ici puis
# référencez son nom dans config.yaml (`webhook: DISCORD_WEBHOOK_CARHARTT`).
DISCORD_WEBHOOK_CARHARTT=https://discord.com/api/webhooks/000000000000000000/yyyyyyyyyyyyyyyyyyyyyyyy

# Bot Discord interactif (optionnel, seulement si `discord_bot.actif: true` dans config.yaml).
# Il remplace alors les webhooks ci-dessus. Le token est un SECRET équivalent à un mot de passe.
DISCORD_BOT_TOKEN=

# Telegram (optionnel, seulement si `telegram.actif: true` dans config.yaml)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
